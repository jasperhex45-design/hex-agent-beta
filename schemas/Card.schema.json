      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "id",
    "version",
    "kind",
    "domains",
    "title",
    "tags",
    "when",
    "avoid_when",
    "rules",
    "failure_signals",
    "scopes",
    "requires_reference_role",
    "conflicts",
    "status",
    "sources",
    "evidence"
