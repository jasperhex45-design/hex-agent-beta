      },
      "minItems": 1,
      "title": "Scopes",
      "type": "array"
    },
    "requires_reference_role": {
      "title": "Requires Reference Role",
      "type": "string"
    },
    "conflicts": {
      "items": {
        "type": "string"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "status": {
      "enum": [
