        "enum": [
          "person",
          "illustration",
          "poster",
          "vehicle",
          "character",
          "prop"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Domains",
      "type": "array"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Tags",
      "type": "array"
    },
    "when": {
      "title": "When",
      "type": "string"
    },
    "avoid_when": {
      "title": "Avoid When",
      "type": "string"
    },
    "rules": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    },
    "failure_signals": {
      "items": {
        "type": "string"
      },
      "title": "Failure Signals",
      "type": "array"
    },
    "scopes": {
      "items": {
        "enum": [
          "create",
          "edit",
          "color_only",
          "relight",
          "scene"
