          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selection State"
    },
    "selection_reason": {
      "default": "",
      "title": "Selection Reason",
      "type": "string"
    }
  },
  "required": [
    "findings",
    "selection_state",
    "selection_reason"
  ],
  "title": "ReferenceAnalysis",
  "type": "object"
}
