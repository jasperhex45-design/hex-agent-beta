{
  "$defs": {
    "RefFinding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "seen": {
          "title": "Seen",
          "type": "boolean"
        },
        "useful": {
          "title": "Useful",
          "type": "boolean"
        },
        "role_in_task": {
          "enum": [
            "identity",
            "canvas",
            "positive",
            "negative",
            "context",
            "reject"
          ],
          "title": "Role In Task",
          "type": "string"
        },
        "visible_facts": {
          "title": "Visible Facts",
          "type": "string"
        },
        "transfer": {
          "items": {
            "type": "string"
          },
          "title": "Transfer",
          "type": "array"
        },
        "do_not_transfer": {
          "items": {
            "type": "string"
          },
          "title": "Do Not Transfer",
          "type": "array"
        },
        "interpretation": {
          "title": "Interpretation",
          "type": "string"
        },
        "uncertainty": {
          "title": "Uncertainty",
          "type": "string"
        },
        "source_kind": {
          "anyOf": [
            {
              "enum": [
                "generated_candidate",
                "user_reference",
                "external_work"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Kind"
        },
        "professional_source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Professional Source Url"
        },
        "professional_excerpt": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Professional Excerpt"
        }
      },
      "required": [
        "id",
        "seen",
        "useful",
        "role_in_task",
        "visible_facts",
        "transfer",
        "do_not_transfer",
        "interpretation",
        "uncertainty",
        "source_kind",
        "professional_source_url",
        "professional_excerpt"
      ],
      "title": "RefFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/RefFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "selection_state": {
      "anyOf": [
        {
          "enum": [
            "exploring",
            "acceptable",
            "uncertain",
            "no_suitable_reference"
