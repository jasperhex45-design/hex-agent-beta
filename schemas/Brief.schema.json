{
  "$defs": {
    "GenerationOptions": {
      "additionalProperties": false,
      "description": "Output settings proposed for this task, not an aesthetic grade.",
      "properties": {
        "desired_aspect_ratio": {
          "default": "auto",
          "title": "Desired Aspect Ratio",
          "type": "string"
        },
        "requested_size": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Size"
        },
        "quality": {
          "default": "auto",
          "maxLength": 30,
          "minLength": 1,
          "title": "Quality",
          "type": "string"
        },
        "output_format": {
          "default": "png",
          "enum": [
            "png",
            "jpeg",
            "webp"
          ],
          "title": "Output Format",
          "type": "string"
        }
      },
      "required": [
        "desired_aspect_ratio",
        "requested_size",
        "quality",
        "output_format"
      ],
      "title": "GenerationOptions",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "identity",
            "scene",
            "style",
            "lighting",
            "color",
            "pose",
            "wardrobe",
            "detail",
            "material",
            "composition",
            "edit_target",
            "aesthetic_positive",
            "aesthetic_negative",
            "acceptance_floor"
          ],
          "title": "Role",
          "type": "string"
        },
        "note": {
          "default": "",
          "maxLength": 1000,
          "title": "Note",
          "type": "string"
        },
        "rights": {
          "default": "unknown",
          "enum": [
            "user_authorized",
            "unknown"
          ],
          "title": "Rights",
          "type": "string"
        },
        "source_url": {
          "default": "",
          "title": "Source Url",
          "type": "string"
        },
        "credit": {
          "default": "",
          "title": "Credit",
          "type": "string"
        },
        "evaluation_only": {
          "default": false,
          "title": "Evaluation Only",
          "type": "boolean"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "path",
        "role"
      ],
      "title": "Reference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "title": {
      "default": "创意任务",
      "maxLength": 120,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "request": {
      "maxLength": 12000,
      "minLength": 2,
      "title": "Request",
      "type": "string"
    },
    "domain": {
      "default": "auto",
      "enum": [
        "auto",
        "person",
        "illustration",
        "poster",
        "vehicle",
        "character",
        "prop"
      ],
      "title": "Domain",
      "type": "string"
    },
    "scope": {
      "default": "create",
      "enum": [
        "create",
        "edit",
        "color_only",
        "relight",
        "scene"
      ],
      "title": "Scope",
      "type": "string"
    },
    "targets": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Targets",
      "type": "array"
    },
    "must_keep": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Must Keep",
      "type": "array"
    },
    "avoid": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Avoid",
      "type": "array"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "maxItems": 8,
      "title": "References",
      "type": "array"
    },
    "color_style": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Color Style"
    },
    "public_search_hint": {
      "default": "",
      "maxLength": 500,
      "title": "Public Search Hint",
      "type": "string"
    },
    "medium": {
      "default": "still",
      "enum": [
        "still",
        "film_shot"
      ],
      "title": "Medium",
      "type": "string"
    },
    "scene_context": {
      "default": "",
      "maxLength": 5000,
      "title": "Scene Context",
      "type": "string"
    },
    "previous_shot": {
      "default": "",
      "maxLength": 2000,
      "title": "Previous Shot",
      "type": "string"
    },
    "next_shot": {
      "default": "",
      "maxLength": 2000,
      "title": "Next Shot",
      "type": "string"
    },
    "exploration_allowed": {
      "default": false,
      "title": "Exploration Allowed",
      "type": "boolean"
    },
    "generation_options": {
      "anyOf": [
        {
          "$ref": "#/$defs/GenerationOptions"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model_comparison": {
      "default": false,
      "title": "Model Comparison",
      "type": "boolean"
    },
    "vehicle_identity": {
      "default": "preserve",
      "enum": [
        "preserve",
        "open"
      ],
      "title": "Vehicle Identity",
      "type": "string"
    }
  },
  "required": [
    "request"
  ],
  "title": "Brief",
  "type": "object"
}
