# Only needed for standalone API mode. Codex-host mode uses the host's capabilities.
# Use exact IDs from YOUR account; do not paste a ChatGPT web session token.
OPENAI_API_KEY=
LIU_TEXT_MODEL=
# Optional phase routing. Design/evaluation/revision use the high-capability
# model; compile and routine execution use the lower-cost model. Empty values
# fall back to LIU_TEXT_MODEL.
LIU_DESIGN_MODEL=
LIU_EXECUTION_MODEL=
# Text model must support image input + Responses Structured Outputs.
LIU_IMAGE_MODEL=
# Image model must support OpenAI Images generation/edit base64 responses.
LIU_SEARCH_MODEL=
# Optional. Defaults to LIU_TEXT_MODEL; must support web_search when used.

# Optional text output cap; actual token cost depends on the model.
LIU_MAX_OUTPUT_TOKENS=10000
